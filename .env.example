# LookupCorps environment variables
# Copy this file to .env.local and fill in what you have.
# The app runs on day one with none of these set — every source has a graceful fallback.

# --- OpenCorporates (global registry search + officers) ---
# Sign up: https://opencorporates.com/api_accounts/new
# Free tier: 500 requests/month
OPENCORPORATES_API_TOKEN=

# --- SEC EDGAR (US public company filings) ---
# No key needed, but SEC requires a User-Agent that identifies you.
# Format: "LookupCorps your@email.com"
SEC_USER_AGENT_EMAIL=your@email.com

# --- Companies House (UK registry) ---
# Sign up: https://developer.company-information.service.gov.uk/get-started
# Free tier: 600 requests / 5 minutes
COMPANIES_HOUSE_API_KEY=

# --- Finnhub (live price + market cap for public companies) ---
# Optional. If missing, the public-company snapshot renders without live price data.
# Sign up: https://finnhub.io/register
# Free tier: 60 API calls/minute
FINNHUB_API_KEY=

# --- Upstash Redis (cache) ---
# Optional. If missing, LookupCorps falls back to an in-memory LRU cache so it runs locally with no signup.
# Sign up: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Wikipedia + Clearbit ---
# No keys needed — public endpoints.
